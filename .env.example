# Server
PORT=4000
NODE_ENV=development
APP_BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173

# Auth
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD=change_me

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
