{
  "name": "kv-infra-crm",
  "version": "0.11.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "predev": "npm run build -w @kv-infra/shared",
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w @kv-infra/api\" \"npm run dev -w @kv-infra/web\"",
    "build": "npm run build -w @kv-infra/shared && npm run build -w @kv-infra/api && npm run build -w @kv-infra/web",
    "pretypecheck": "npm run build -w @kv-infra/shared",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "pretest": "npm run build -w @kv-infra/shared",
    "test": "npm run test --workspaces --if-present",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
